{
  "name": "ttek/tk-domtemplate",
  "type": "library",
  "description": "PHP DomTemplate library",
  "keywords": [
    "tropotek",
    "DomTemplate",
    "DOM",
    "HTML",
    "XML",
    "scss"
  ],
  "time": "2025-07-12",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Mifsud",
      "homepage": "https://www.tropotek.com/"
    }
  ],
  "funding": [
    {
      "type": "Paypal",
      "url": "https://www.paypal.me/tropotek"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tk\\DomTemplate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tk\\DomTemplate\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "ext-libxml": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-tidy": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "9.0.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --no-progress --memory-limit=512M",
    "check": [
      "@stan",
      "@test"
    ]
  }
}
