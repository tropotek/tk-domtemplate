# Copy to .env and adjust. docker compose reads .env automatically.

# Address and port the example site is published on.
# Use this machine's LAN IP to reach it from other devices, or 0.0.0.0 for all interfaces.
APP_HOST=127.0.0.1
HTTP_APP_PORT=8080

# Container user, match your host user (id -u / id -g) so vendor/ stays editable
APP_UID=1000
APP_GID=1000
